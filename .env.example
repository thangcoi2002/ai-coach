API_URL=https://api.example.com

# Google sign-in — from the Google Cloud project's OAuth credentials.
# iOS works with GOOGLE_IOS_CLIENT_ID alone; Android and the backend's
# ID-token verification need GOOGLE_WEB_CLIENT_ID.
# Changing these needs `npm start -- --reset-cache`: the values are inlined
# into the bundle at build time.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
